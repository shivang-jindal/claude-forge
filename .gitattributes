# Normalize line endings: LF in the repository, so diffs stay clean on every
# platform and CI results match local results.
* text=auto eol=lf

# Windows scripts must keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# These are never line-ending sensitive; keep them as-is.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.tgz binary
